# ==========================================================
#  Agrismart API - Exemple de configuration
#  Copiez ce fichier en « .env » puis adaptez les valeurs.
# ==========================================================

# ---------- Serveur ----------
PORT=3000
NODE_ENV=development

# ---------- PostgreSQL ----------
# Identifiants de la base dédiée à l'API (voir scripts/setup-db.ps1)
PGHOST=localhost
PGPORT=5432
PGUSER=agrismart
PGPASSWORD=agrismart_dev_2024
PGDATABASE=agrismart

# ---------- Sécurité (JWT) ----------
# OBLIGATOIRE en production : secret long et aléatoire (>= 32 caractères)
JWT_SECRET=changez_moi_par_un_secret_long_et_aleatoire
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# Origines autorisées séparées par des virgules, ou * pour tout autoriser (dev mobile)
CORS_ORIGIN=*

# ---------- Météo (proxy Open-Meteo) ----------
METEO_URL=https://api.open-meteo.com/v1/forecast
METEO_CACHE_TTL_MIN=10
